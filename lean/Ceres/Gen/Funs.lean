def timing.check.known_difference
  (net : ceres_netlist.timer.NetTimer) (access : ceres_netlist.timer.Access) :
  Result Bool
  := do
  let now ← ceres_netlist.timer.NetTimer.clock_of net.tac net.tac net.count
  let (access1, tac, count, glitch) ←
    match access with
    | ceres_netlist.timer.Access.None =>
      ok (ceres_netlist.timer.Access.None, net.tac, net.count, false)
    | ceres_netlist.timer.Access.Read _ =>
      ok (access, net.tac, net.count, false)
    | ceres_netlist.timer.Access.Write r val =>
      do
      let (i, i1, b) ←
        match r with
        | ceres_netlist.timer.Reg.Div => ok (net.tac, 0#u16, now)
        | ceres_netlist.timer.Reg.Tima => ok (net.tac, net.count, false)
        | ceres_netlist.timer.Reg.Tma => ok (net.tac, net.count, false)
        | ceres_netlist.timer.Reg.Tac =>
          do
          let new ← lift (val &&& 7#u8)
          let between ←
            ceres_netlist.timer.NetTimer.clock_of new net.tac net.count
          let after ← ceres_netlist.timer.NetTimer.clock_of new new net.count
          ok (new, net.count, now && (¬ (between && after)))
      ok (access, i, i1, b)
  let tma ←
    match access1 with
    | ceres_netlist.timer.Access.None => ok net.tma
    | ceres_netlist.timer.Access.Read _ => ok net.tma
    | ceres_netlist.timer.Access.Write r val =>
      match r with
      | ceres_netlist.timer.Reg.Div => ok net.tma
      | ceres_netlist.timer.Reg.Tima => ok net.tma
      | ceres_netlist.timer.Reg.Tma => ok val
      | ceres_netlist.timer.Reg.Tac => ok net.tma
  let i ← lift (net.tima &&& 128#u8)
  let b ← ceres_netlist.timer.NetTimer.clock_of tac tac count
  let i1 ← lift (core.num.U16.wrapping_add count 1#u16)
  let b1 ← ceres_netlist.timer.NetTimer.clock_of tac tac i1
  ok (((net.int_timer && glitch) || ((((¬ net.int_timer) && net.bit7_before)
    && (i = 0#u8)) && (glitch || (b && (¬ b1))))) || (((((¬ net.int_timer) &&
    (¬ net.bit7_before)) && (net.tima = 255#u8)) && glitch) || ((net.int_timer
    && (tma = 255#u8)) && (b && (¬ b1)))))

/-- [ceres_core::timing::check::step_agrees]:
    Source: 'ceres-core/src/timing/check.rs', lines 273:0-313:1 -/
def timing.check.step_agrees
  (net : ceres_netlist.timer.NetTimer) (clock : timing.timer.Clock)
  (access : ceres_netlist.timer.Access) (serial_div_mask : Std.U16) :
  Result Bool
  := do
  let b ← timing.check.related net clock
  let b1 ← timing.check.known_difference net access
  if (¬ b) || b1
  then ok true
  else
    let host ← timing.check.CheckHost.new serial_div_mask
    let ((net_read, net_irq), net1) ←
      ceres_netlist.timer.NetTimer.m_cycle net access
    let ((ceres_read, ceres_irq, twice), clock1, _) ←
      timing.check.ceres_m_cycle clock host access
    let b2 ← timing.check.same_read net_read ceres_read
    let b3 ← timing.check.same_interrupt net_irq ceres_irq
    let b4 ← timing.check.related net1 clock1
    ok (((b2 && b3) && (¬ twice)) && b4)

