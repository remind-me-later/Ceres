# Ceres's loop does not end the window's first tile's fetch as its first pixel comes out.
# harness: netlist_mode3_window_starting
diff --git a/ceres-core/src/ppu/display/mode3.rs b/ceres-core/src/ppu/display/mode3.rs
index 4a8932a1..4e0c2207 100644
--- a/ceres-core/src/ppu/display/mode3.rs
+++ b/ceres-core/src/ppu/display/mode3.rs
@@ -201,7 +201,7 @@ pub(super) fn mode3<P: Mode3Ppu>(p: &mut P, resume: State) -> Mode3Flow {
                 let held = enabled && d.objs.next().is_some_and(|e| e.x == 0);
                 if !held && let Some((item, popped)) = d.bg.pop(scx, d.window.being_fetched) {
                     if popped != Popped::Restarted {
-                        d.window.being_fetched = false;
+                        d.window.being_fetched = true;
                     }
                     p.mix_pixel(item, popped);
                 }
