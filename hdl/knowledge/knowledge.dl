// The knowledge base, in Datalog (Soufflé): what the repository knows
// about the hardware, the readable model and ceres, read from the tables
// ../knowledge.sh builds from the sources (build/knowledge/*.tsv), the
// checks that must find nothing, and the queries. Every table is generated;
// the hand-written judgement lives in doc/facts.toml (the facts),
// hdl/races.toml (the races' verdicts), hdl/rules.toml (the rules) and
// doc/assumptions.toml (what the proofs assume). Each check and each query
// is a relation, written to its own file; ../knowledge.sh check fails if a
// check is not empty, and ../knowledge.sh NAME prints a query.
//
//   souffle -F build/knowledge -D OUT knowledge/knowledge.dl

// The tables.

// The readable model (hdl/rtl, knowledge/rtl.awk, oracle/controls.awk).

// An instance: the entity it is in, its label, its own entity.
.decl instance(parent: symbol, label: symbol, entity: symbol)
// A signal or a port, by the entity that declares it.
.decl signal(entity: symbol, name: symbol)
// A signal that controls storage: it clocks a flip-flop ("edge"), or a
// latch, an asynchronous set or reset or a process with no clock tests it
// ("level"). A bit is name(i), i a number or "i" for any.
.decl control(entity: symbol, kind: symbol, signal: symbol)
// An assignment with delays (`after`): where, the signal assigned, and its
// delays apart by spaces (tco is a flip-flop's clock-to-output).
.decl delay(file: symbol, line: number, entity: symbol, signal: symbol, delays: symbol)
// A port of an entity and its direction (in, out, inout, buffer); an
// instance's port and a signal of the entity it is in that its actual
// reads or drives; a signal (or variable) an assignment reads, and the one
// it assigns, in an entity (in its expression, or the conditions of the
// ifs and cases around it); a tag's anchors in rtl/, the signals the
// statement after an `@fact` or `@rule` tag assigns.
.decl port(entity: symbol, port: symbol, direction: symbol)
.decl portmap(entity: symbol, label: symbol, instance: symbol, port: symbol, signal: symbol)
.decl flow(entity: symbol, source: symbol, target: symbol)
.decl anchor(kind: symbol, id: symbol, entity: symbol, signal: symbol)
// An `@hw` tag: what the code rests on (die: the die's cells; measured:
// dmg-sim or hardware; inferred).
.decl hw_tag(file: symbol, line: number, entity: symbol, kind: symbol, text: symbol)
// The short pulses of the model's runs (find-runts.sh): the ROM, the entity
// and signal (a bit as name(i)), its path, how many, the shortest (ns), when
// the first began (ms), their level (0, 1, b: both).
.decl runt(rom: symbol, entity: symbol, signal: symbol, path: symbol, pulses: number,
           shortest_ns: float, first_ms: float, level: symbol)

// The facts (doc/facts.toml; its header says what the fields mean), their
// models, tests, open questions and needs, and their `@fact` tags in the
// code and the documents.
.decl fact(id: symbol, title: symbol, netlist: symbol, hardware: symbol,
           emulators: symbol, race: symbol, note: symbol)
.decl fact_model(fact: symbol, model: symbol)
.decl fact_test(fact: symbol, rom: symbol)
.decl fact_open(fact: symbol, question: symbol)
.decl fact_need(fact: symbol, need: symbol)
.decl fact_tag(fact: symbol, file: symbol, line: number)

// The races' verdicts (hdl/races.toml): order or width and the evidence;
// the models whose readable model has each; the facts that rest on each;
// the delays (signal tco: all the flip-flops') and the signals with short
// pulses that each covers (a vector's name covers every bit).
.decl race(id: symbol, title: symbol, race: symbol, evidence: symbol)
.decl race_model(race: symbol, model: symbol)
.decl race_fact(race: symbol, fact: symbol)
.decl race_delay(race: symbol, entity: symbol, signal: symbol)
.decl race_signal(race: symbol, entity: symbol, signal: symbol)

// The rules the model needs beyond the die's connectivity (hdl/rules.toml):
// kind (delay, outcome, logic, ram, state, analogue, unknown), status
// (applied, proposed, missing) and the evidence; the models each is for,
// the facts it explains, the width races it settles, and the `@rule` tags
// of rtl/ (with the entity and the chips the code is for: all, dmg or cgb,
// by the `REVISION` generate it is in); the models that would follow one
// of its models and do not (not_on).
.decl rule(id: symbol, title: symbol, kind: symbol, status: symbol, evidence: symbol)
.decl rule_model(rule: symbol, model: symbol)
.decl rule_not_on(rule: symbol, model: symbol)
.decl rule_fact(rule: symbol, fact: symbol)
.decl rule_race(rule: symbol, race: symbol)
.decl rule_tag(rule: symbol, file: symbol, line: number, entity: symbol, branch: symbol)

// What the proofs against the netlist assume (doc/assumptions.toml): the
// evidence (proved, replayed, measured, fact or open) and how; the facts
// each rests on and the assumptions it takes as given in turn; ceres-core's
// Kani harnesses, and their tags: what each assumes, and what it
// discharges (proves for the others).
.decl assumption(id: symbol, title: symbol, evidence: symbol, how: symbol)
.decl assumption_fact(assumption: symbol, fact: symbol)
.decl assumption_rests(assumption: symbol, on: symbol)
.decl harness(name: symbol, file: symbol, line: number)
.decl harness_tag(function: symbol, claim: symbol, assumption: symbol, file: symbol,
                  line: number)

// The chips looked at (knowledge.sh's MODELS): by default all that rtl/ has.
.decl tree_model(model: symbol)

.input instance(IO=file, filename="instance.tsv")
.input signal(IO=file, filename="signal.tsv")
.input control(IO=file, filename="control.tsv")
.input delay(IO=file, filename="delay.tsv")
.input hw_tag(IO=file, filename="hw_tag.tsv")
.input port(IO=file, filename="port.tsv")
.input portmap(IO=file, filename="portmap.tsv")
.input flow(IO=file, filename="flow.tsv")
.input anchor(IO=file, filename="anchor.tsv")
.input runt(IO=file, filename="runt.tsv")
.input fact(IO=file, filename="fact.tsv")
.input fact_model(IO=file, filename="fact_model.tsv")
.input fact_test(IO=file, filename="fact_test.tsv")
.input fact_open(IO=file, filename="fact_open.tsv")
.input fact_need(IO=file, filename="fact_need.tsv")
.input fact_tag(IO=file, filename="fact_tag.tsv")
.input race(IO=file, filename="race.tsv")
.input race_model(IO=file, filename="race_model.tsv")
.input race_fact(IO=file, filename="race_fact.tsv")
.input race_delay(IO=file, filename="race_delay.tsv")
.input race_signal(IO=file, filename="race_signal.tsv")
.input rule(IO=file, filename="rule.tsv")
.input rule_model(IO=file, filename="rule_model.tsv")
.input rule_not_on(IO=file, filename="rule_not_on.tsv")
.input rule_fact(IO=file, filename="rule_fact.tsv")
.input rule_race(IO=file, filename="rule_race.tsv")
.input rule_tag(IO=file, filename="rule_tag.tsv")
.input assumption(IO=file, filename="assumption.tsv")
.input assumption_fact(IO=file, filename="assumption_fact.tsv")
.input assumption_rests(IO=file, filename="assumption_rests.tsv")
.input harness(IO=file, filename="harness.tsv")
.input harness_tag(IO=file, filename="harness_tag.tsv")
.input tree_model(IO=file, filename="tree_model.tsv")

// The models, as doc/facts.toml names them, and how they stand to each
// other: the CGB-C and the CGB-E are revisions of the CGB, and what is
// said of the CGB is said of them. The CGB follows the DMG where nothing
// says otherwise (hdl/rules.toml's header), and the MGB and the SGB do,
// as they have the DMG-CPU's logic.
.decl model(model: symbol)
model("dmg"). model("mgb"). model("sgb"). model("cgb"). model("cgb-c"). model("cgb-e").
.decl revision_of(revision: symbol, model: symbol)
revision_of("cgb-c", "cgb").
revision_of("cgb-e", "cgb").
.decl follows(model: symbol, other: symbol)
follows("cgb", "dmg").
follows("mgb", "dmg").
follows("sgb", "dmg").

// What is said of a model is said of it and of its revisions; two names
// overlap where one covers the other.
.decl covers(model: symbol, other: symbol)
covers(m, m) :- model(m).
covers(m, r) :- covers(m, n), revision_of(r, n).
.decl overlaps(model: symbol, other: symbol)
overlaps(m, n) :- covers(m, n).
overlaps(m, n) :- covers(n, m).

// Where a rule holds: on the models its entry states, with their
// revisions; and, recursively, on a model that follows one it holds on,
// with its revisions, unless the entry says not_on.
.decl rule_holds(rule: symbol, model: symbol)
rule_holds(r, n) :- rule_model(r, m), covers(m, n).
rule_holds(r, n) :- rule_holds(r, m), follows(n, m), !rule_not_on(r, n).
rule_holds(r, k) :- rule_holds(r, n), revision_of(k, n), !rule_not_on(r, k).
// Where it is stated, and where it would hold with no not_on.
.decl rule_stated(rule: symbol, model: symbol)
rule_stated(r, n) :- rule_model(r, m), covers(m, n).
.decl rule_reaches(rule: symbol, model: symbol)
rule_reaches(r, n) :- rule_stated(r, n).
rule_reaches(r, n) :- rule_reaches(r, m), follows(n, m).
rule_reaches(r, k) :- rule_reaches(r, n), revision_of(k, n).

// The chips of rtl/: each top's entity, and every entity it reaches
// through instances (recursively); a rule is applied on a chip where a tag
// of it is in an entity the chip reaches, outside the other chip's branch.
.decl chip_top(model: symbol, entity: symbol)
chip_top("dmg", "dmg_cpu_b").
chip_top("cgb", "cgb_cpu").
.decl in_chip(model: symbol, entity: symbol)
in_chip(m, e) :- chip_top(m, e).
in_chip(m, e) :- in_chip(m, p), instance(p, _, e).
.decl rule_applied_on(rule: symbol, model: symbol)
rule_applied_on(r, m) :-
    rule_tag(r, _, _, e, b), in_chip(c, e), (b = "all" ; b = c), covers(c, m).

// The model's signals as a graph: a node is an entity's signal, an edge
// goes from what an assignment reads to what it assigns, and through the
// port maps, from an actual into an instance's input and out of its output
// (both ways for an inout). An entity's instances share its nodes. The
// CPU's bus in the chips' tops and the CPU core are left out: every
// register hangs on the bus, and through it (and through software) every
// signal would reach every other.
.decl cpu_bus(signal: symbol)
cpu_bus("data"). cpu_bus("addr"). cpu_bus("cpu_rd"). cpu_bus("cpu_wr").
.decl through_cpu(entity: symbol, signal: symbol)
through_cpu(e, s) :- chip_top(_, e), cpu_bus(s).
through_cpu(e, s) :- flow(e, s, _), match("sm83.*", e).
through_cpu(e, s) :- flow(e, _, s), match("sm83.*", e).
through_cpu(e, s) :- port(e, s, _), match("sm83.*", e).
.decl edge(entity: symbol, signal: symbol, to_entity: symbol, to_signal: symbol)
edge(e, a, e, b) :- flow(e, a, b), !through_cpu(e, a), !through_cpu(e, b).
edge(p, s, c, f) :-
    portmap(p, _, c, f, s), port(c, f, d), d != "out", !through_cpu(p, s), !through_cpu(c, f).
edge(c, f, p, s) :-
    portmap(p, _, c, f, s), port(c, f, d), d != "in", !through_cpu(p, s), !through_cpu(c, f).

// Where the races and the facts sit: a race at its signals (a vector's
// name for every bit) and the signals of its delays; a fact at the anchors
// of its `@fact` tags, and of the `@rule` tags of the rules that explain
// it.
.decl race_at(race: symbol, entity: symbol, signal: symbol)
race_at(r, e, s) :- race_signal(r, e, s).
race_at(r, e, s) :- race_delay(r, e, s), e != "".
.decl fact_at(fact: symbol, entity: symbol, signal: symbol)
fact_at(f, e, s) :- anchor("fact", f, e, s).
fact_at(f, e, s) :- rule_fact(r, f), anchor("rule", r, e, s).

// What each of those places reaches, recursively.
.decl seed(entity: symbol, signal: symbol)
seed(e, s) :- race_at(_, e, s).
seed(e, s) :- fact_at(_, e, s).
.decl reaches(entity: symbol, signal: symbol, to_entity: symbol, to_signal: symbol)
reaches(e, s, e, s) :- seed(e, s).
reaches(e, s, e2, s2) :- reaches(e, s, e1, s1), edge(e1, s1, e2, s2).

// A race and a fact are connected where a signal of one reaches one of the
// other's, either way: the logic of a fact feeds the storage that takes
// the race's pulse, or the race's outcome flows into what the fact shows.
.decl connected(race: symbol, fact: symbol)
connected(r, f) :- race_at(r, e, s), fact_at(f, e2, s2), reaches(e, s, e2, s2).
connected(r, f) :- race_at(r, e, s), fact_at(f, e2, s2), reaches(e2, s2, e, s).

// How near a race and a fact are: the shortest path between their
// signals, either way, where it is at most 3 edges (the links of
// races.toml are 0 to 2; most other pairs are farther).
.decl near(entity: symbol, signal: symbol, to_entity: symbol, to_signal: symbol, d: number)
near(e, s, e, s, 0) :- seed(e, s).
near(e, s, e2, s2, d + 1) :- near(e, s, e1, s1, d), d < 3, edge(e1, s1, e2, s2).
.decl near_pair(race: symbol, fact: symbol, d: number)
near_pair(r, f, d) :- race_at(r, e, s), fact_at(f, e2, s2), near(e, s, e2, s2, d).
near_pair(r, f, d) :- race_at(r, e, s), fact_at(f, e2, s2), near(e2, s2, e, s, d).
.decl nearest(race: symbol, fact: symbol, d: number)
nearest(r, f, m) :- near_pair(r, f, _), m = min d : { near_pair(r, f, d) }.

// What the tables say, for the chips looked at.

// The rules, races and facts of the chips looked at.
.decl rule_here(rule: symbol)
rule_here(r) :- rule_holds(r, m), tree_model(m).
.decl race_here(race: symbol)
race_here(r) :- race_model(r, m), tree_model(n), overlaps(m, n).
.decl fact_here(fact: symbol)
fact_here(f) :- fact_model(f, m), tree_model(n), overlaps(m, n).

// A signal's name without its bit: "lines" for "lines(4)".
.decl runt_signal(signal: symbol)
runt_signal(s) :- runt(_, _, s, _, _, _, _, _).
.decl paren(signal: symbol, at: number)
paren(s, j) :- runt_signal(s), j = range(0, strlen(s)), substr(s, j, 1) = "(".
.decl base(signal: symbol, base: symbol)
base(s, s) :- runt_signal(s), !contains("(", s).
base(s, substr(s, 0, i)) :- runt_signal(s), contains("(", s), i = min j : { paren(s, j) }.

// The short pulses at a control: what a flip-flop or a latch may take or
// not by the die's physics, by the control's signal (a bit, the vector, or
// any bit of it).
.decl runt_at_control(rom: symbol, entity: symbol, signal: symbol, path: symbol,
                      pulses: number, shortest_ns: float, first_ms: float, level: symbol,
                      kind: symbol)
runt_at_control(rom, e, s, path, n, ns, ms, level, kind) :-
    runt(rom, e, s, path, n, ns, ms, level), control(e, kind, c), base(s, b),
    (c = s ; c = b ; c = cat(b, "(i)")).

// A race of the chips looked at covers a delay: its own, or every
// flip-flop's (tco).
.decl delay_covered(entity: symbol, signal: symbol, delays: symbol)
delay_covered(e, s, d) :- delay(_, _, e, s, d), race_delay(r, e, s), race_here(r).
delay_covered(e, s, "tco") :- delay(_, _, e, s, "tco"), race_delay(r, "", "tco"), race_here(r).

// A race of the chips looked at covers the pulses at a signal: by its
// name, or by its vector's.
.decl pulse_covered(entity: symbol, signal: symbol)
pulse_covered(e, s) :- runt_at_control(_, e, s, _, _, _, _, _, _), race_signal(r, e, s), race_here(r).
pulse_covered(e, s) :-
    runt_at_control(_, e, s, _, _, _, _, _, _), base(s, b), race_signal(r, e, b), race_here(r).

// The facts that need a rule: the model misses a hardware test (the netlist
// differs from ceres where ceres matches the hardware, or both miss it), is
// silent where a test shows the outcome, or rests on a width race that a
// test shows.
.decl fact_needing_rule(fact: symbol)
fact_needing_rule(f) :- fact(f, _, "differs", "same", _, _, _).
fact_needing_rule(f) :- fact(f, _, "same", "differs", _, _, _).
fact_needing_rule(f) :- fact(f, _, "silent", h, _, _, _), h != "none".
fact_needing_rule(f) :- fact(f, _, n, h, _, "width", _), n != "none", h != "none".

// What a proof rests on: what its harness assumes, what those rest on in
// turn, and what the harnesses that prove them rest on (recursively: a
// proof that discharges an assumption brings in its own).
.decl assumes(harness: symbol, assumption: symbol)
assumes(h, a) :- harness_tag(h, "assumes", a, _, _).
.decl discharges(harness: symbol, assumption: symbol)
discharges(h, a) :- harness_tag(h, "discharges", a, _, _).
.decl rests(harness: symbol, assumption: symbol)
rests(h, a) :- assumes(h, a).
rests(h, b) :- rests(h, a), assumption_rests(a, b).
rests(h, b) :- rests(h, a), discharges(p, a), rests(p, b).

// The checks: each must find nothing.

// The rules applied in rtl/ that no `@rule` tag shows, and the tags that
// name no rule applied here.
.decl applied_rules_without_tag(rule: symbol, problem: symbol)
.decl rule_tagged(rule: symbol)
rule_tagged(r) :- rule_tag(r, _, _, _, _).
.decl rule_applied_here(rule: symbol)
rule_applied_here(r) :- rule(r, _, _, "applied", _), rule_here(r).
applied_rules_without_tag(r, "no tag") :- rule_applied_here(r), !rule_tagged(r).
applied_rules_without_tag(r, cat("tag at ", file, ":", to_string(line), " of a rule not applied here")) :-
    rule_tag(r, file, line, _, _), !rule_applied_here(r).

// The delays of rtl/ that no race of races.toml covers.
.decl delays_without_verdict(file: symbol, line: number, entity: symbol, signal: symbol,
                             delays: symbol)
delays_without_verdict(file, line, e, s, d) :- delay(file, line, e, s, d), !delay_covered(e, s, d).

// The facts about the chips looked at that need a rule of rules.toml for
// them and have none.
.decl facts_without_rule(id: symbol, netlist: symbol, hardware: symbol, race: symbol,
                         title: symbol)
.decl fact_explained(fact: symbol)
fact_explained(f) :- rule_fact(r, f), rule_here(r).
facts_without_rule(f, n, h, race, title) :-
    fact_needing_rule(f), fact_here(f), !fact_explained(f), fact(f, title, n, h, _, race, _).

// The pulses under 10 ns at a control that no race of races.toml covers: by
// signal, in how many ROMs, how many pulses, the shortest, and a ROM that
// shows the shortest (the first by name).
.decl pulses_without_verdict(entity: symbol, signal: symbol, kind: symbol, roms: number,
                             pulses: number, shortest_ns: float, a_rom: symbol)
.decl pulse_signal(entity: symbol, signal: symbol, kind: symbol)
pulse_signal(e, s, kind) :- runt_at_control(_, e, s, _, _, _, _, _, kind).
.decl pulse_rom(entity: symbol, signal: symbol, kind: symbol, rom: symbol)
pulse_rom(e, s, kind, rom) :- runt_at_control(rom, e, s, _, _, _, _, _, kind).
.decl pulse_shortest(entity: symbol, signal: symbol, kind: symbol, shortest_ns: float)
pulse_shortest(e, s, kind, shortest) :-
    pulse_signal(e, s, kind),
    shortest = min ns : { runt_at_control(_, e, s, _, _, ns, _, _, kind) }.
.decl shortest_rom(entity: symbol, signal: symbol, kind: symbol, rom: symbol)
shortest_rom(e, s, kind, rom) :-
    pulse_shortest(e, s, kind, ns), runt_at_control(rom, e, s, _, _, ns, _, _, kind).
.decl later_rom(entity: symbol, signal: symbol, kind: symbol, rom: symbol)
later_rom(e, s, kind, rom) :-
    shortest_rom(e, s, kind, rom), shortest_rom(e, s, kind, other), other < rom.
pulses_without_verdict(e, s, kind, roms, pulses, shortest, rom) :-
    pulse_shortest(e, s, kind, shortest), shortest < 10, !pulse_covered(e, s),
    roms = count : { pulse_rom(e, s, kind, _) },
    pulses = sum n : { runt_at_control(_, e, s, _, n, _, _, _, kind) },
    shortest_rom(e, s, kind, rom), !later_rom(e, s, kind, rom).

// The delays and signals of the races of the chips looked at that rtl/ does
// not have.
.decl races_naming_nothing(race: symbol, entity: symbol, signal: symbol, what: symbol)
.decl delay_signal(entity: symbol, signal: symbol)
delay_signal(e, s) :- delay(_, _, e, s, _).
races_naming_nothing(r, e, s, "delay") :-
    race_delay(r, e, s), race_here(r), (e != "" ; s != "tco"), !delay_signal(e, s).
races_naming_nothing(r, e, s, "signal") :- race_signal(r, e, s), race_here(r), !signal(e, s).

// The rules that explain the same facts as another: one of them is enough.
// A row per fact they explain.
.decl rules_explaining_the_same(rule: symbol, also: symbol, fact: symbol)
.decl explaining(rule: symbol)
explaining(r) :- rule_fact(r, _).
.decl explain_other(a: symbol, b: symbol)
explain_other(a, b) :- explaining(a), explaining(b), a < b, rule_fact(a, f), !rule_fact(b, f).
explain_other(a, b) :- explaining(a), explaining(b), a < b, rule_fact(b, f), !rule_fact(a, f).
rules_explaining_the_same(a, b, f) :-
    explaining(a), explaining(b), a < b, !explain_other(a, b), rule_fact(a, f).

// The facts about the chips looked at on a width race of the netlist that
// no race of theirs names.
.decl width_facts_without_race(id: symbol, title: symbol)
.decl fact_with_race_here(fact: symbol)
fact_with_race_here(f) :- race_fact(r, f), race_here(r).
width_facts_without_race(f, title) :-
    fact_here(f), fact(f, title, n, _, _, "width", _), n != "none", !fact_with_race_here(f).

// The tags and the fields of doc/assumptions.toml that name nothing: an
// assumption, a fact.
.decl assumptions_naming_nothing(place: symbol, names: symbol)
.decl assumption_id(id: symbol)
assumption_id(a) :- assumption(a, _, _, _).
.decl fact_id(id: symbol)
fact_id(f) :- fact(f, _, _, _, _, _, _).
assumptions_naming_nothing(cat(file, ":", to_string(line)), a) :-
    harness_tag(_, _, a, file, line), !assumption_id(a).
assumptions_naming_nothing(cat("doc/assumptions.toml [", a, "] rests_on"), b) :-
    assumption_rests(a, b), !assumption_id(b).
assumptions_naming_nothing(cat("doc/assumptions.toml [", a, "] facts"), f) :-
    assumption_fact(a, f), !fact_id(f).

// The tags on what is not a Kani harness, and the harnesses against the
// netlist (named netlist_*) that state nothing they assume or prove.
.decl harnesses_stating_nothing(harness: symbol, problem: symbol)
.decl harness_name(name: symbol)
harness_name(h) :- harness(h, _, _).
.decl stating(harness: symbol)
stating(h) :- harness_tag(h, _, _, _, _).
harnesses_stating_nothing(h, cat("tagged at ", file, ":", to_string(line), ", not a harness")) :-
    harness_tag(h, _, _, file, line), !harness_name(h).
harnesses_stating_nothing(h, "a harness against the netlist with no tag") :-
    harness(h, _, _), match("netlist_.*", h), !stating(h).

// The assumptions whose evidence does not hold: proved that no harness
// proves, a fact that names no fact, the others without a how; and the
// entries nothing assumes, proves or rests on.
.decl assumptions_without_evidence(assumption: symbol, problem: symbol)
.decl discharged(assumption: symbol)
discharged(a) :- discharges(_, a).
.decl with_fact(assumption: symbol)
with_fact(a) :- assumption_fact(a, _).
.decl used(assumption: symbol)
used(a) :- harness_tag(_, _, a, _, _).
used(b) :- assumption_rests(_, b).
assumptions_without_evidence(a, "proved, and no harness discharges it") :-
    assumption(a, _, "proved", _), !discharged(a).
assumptions_without_evidence(a, "a fact, and names none") :-
    assumption(a, _, "fact", _), !with_fact(a).
assumptions_without_evidence(a, cat(e, ", and says not how")) :-
    assumption(a, _, e, ""), e != "proved".
assumptions_without_evidence(a, "discharged, but not proved") :-
    assumption(a, _, e, _), e != "proved", discharged(a).
assumptions_without_evidence(a, "nothing assumes, proves or rests on it") :-
    assumption_id(a), !used(a).

// The proofs that rest on what they prove, through the others.
.decl proofs_resting_on_themselves(harness: symbol, assumption: symbol)
proofs_resting_on_themselves(h, a) :- discharges(h, a), rests(h, a).

// The applied rules that hold on a chip looked at and that rtl/ applies
// only on others, and those that rtl/ applies where not_on says they do
// not hold.
.decl applied_rules_off_their_models(rule: symbol, model: symbol, problem: symbol)
applied_rules_off_their_models(r, m, "holds there, and rtl/ applies it only on other chips") :-
    rule(r, _, _, "applied", _), rule_holds(r, m), tree_model(m), !rule_applied_on(r, m).
applied_rules_off_their_models(r, m, "not_on names it, and rtl/ applies it there") :-
    rule_applied_on(r, m), rule_not_on(r, n), covers(n, m), tree_model(m).

// The models a rule's not_on names that it states, or that it would not
// reach anyway.
.decl rules_not_on_nothing(rule: symbol, model: symbol, problem: symbol)
rules_not_on_nothing(r, m, "its models name it") :- rule_not_on(r, m), rule_stated(r, m).
rules_not_on_nothing(r, m, "it would not follow there") :- rule_not_on(r, m), !rule_reaches(r, m).

// The races and the facts that rest on them that no signal connects, where
// both sit somewhere in rtl/.
.decl races_not_reaching_their_facts(race: symbol, fact: symbol)
.decl race_placed(race: symbol)
race_placed(r) :- race_at(r, _, _).
.decl fact_placed(fact: symbol)
fact_placed(f) :- fact_at(f, _, _).
races_not_reaching_their_facts(r, f) :-
    race_fact(r, f), race_placed(r), fact_placed(f), !connected(r, f).

// The checks' names and what each finds, for ../knowledge.sh.
.decl check(name: symbol, title: symbol)
check("assumptions-naming-nothing",
      "The tags of the proofs and the fields of doc/assumptions.toml that name no assumption or fact.").
check("assumptions-without-evidence",
      "The assumptions whose evidence does not hold, and those nothing uses.").
check("harnesses-stating-nothing",
      "The tags that are not on a Kani harness, and the harnesses against the netlist with no tag.").
check("proofs-resting-on-themselves",
      "The proofs that rest, through the others, on what they prove.").
check("applied-rules-off-their-models",
      "The applied rules that hold on a chip looked at and that rtl/ applies only on others, or that rtl/ applies where not_on says they do not hold.").
check("races-not-reaching-their-facts",
      "The races and the facts that rest on them, both in rtl/, that no signal connects either way.").
check("rules-not-on-nothing",
      "The models a rule's not_on names that its models name, or that it would not follow to.").
check("applied-rules-without-tag",
      "The rules applied in rtl/ that no `@rule` tag shows, and the tags that name no rule applied here.").
check("delays-without-verdict",
      "The delays of rtl/ that no race of races.toml covers.").
check("facts-without-rule",
      "The facts about the chips looked at that need a rule of rules.toml for them and have none.").
check("pulses-without-verdict",
      "The pulses under 10 ns at a control that no race of races.toml covers.").
check("races-naming-nothing",
      "The delays and signals of the races of the chips looked at that rtl/ does not have.").
check("rules-explaining-the-same",
      "The rules that explain the same facts as another: one of them is enough.").
check("width-facts-without-race",
      "The facts about the chips looked at on a width race of the netlist that no race of theirs names.").
.output check(IO=file, filename="checks.tsv")

.output assumptions_naming_nothing(IO=file, filename="assumptions-naming-nothing.tsv", headers=true)
.output assumptions_without_evidence(IO=file, filename="assumptions-without-evidence.tsv", headers=true)
.output harnesses_stating_nothing(IO=file, filename="harnesses-stating-nothing.tsv", headers=true)
.output proofs_resting_on_themselves(IO=file, filename="proofs-resting-on-themselves.tsv", headers=true)

.output applied_rules_off_their_models(IO=file, filename="applied-rules-off-their-models.tsv", headers=true)
.output races_not_reaching_their_facts(IO=file, filename="races-not-reaching-their-facts.tsv", headers=true)
.output rules_not_on_nothing(IO=file, filename="rules-not-on-nothing.tsv", headers=true)
.output applied_rules_without_tag(IO=file, filename="applied-rules-without-tag.tsv", headers=true)
.output delays_without_verdict(IO=file, filename="delays-without-verdict.tsv", headers=true)
.output facts_without_rule(IO=file, filename="facts-without-rule.tsv", headers=true)
.output pulses_without_verdict(IO=file, filename="pulses-without-verdict.tsv", headers=true)
.output races_naming_nothing(IO=file, filename="races-naming-nothing.tsv", headers=true)
.output rules_explaining_the_same(IO=file, filename="rules-explaining-the-same.tsv", headers=true)
.output width_facts_without_race(IO=file, filename="width-facts-without-race.tsv", headers=true)

// Lists in a cell: the items of a list (by its name and its key) joined
// by spaces, in their order by name; "" for a key with no items.
.decl member(list: symbol, key: symbol, item: symbol)
.decl has_members(list: symbol, key: symbol)
has_members(l, k) :- member(l, k, _).
.decl not_first(list: symbol, key: symbol, item: symbol)
not_first(l, k, b) :- member(l, k, a), member(l, k, b), a < b.
.decl between(list: symbol, key: symbol, a: symbol, b: symbol)
between(l, k, a, b) :- member(l, k, a), member(l, k, c), member(l, k, b), a < c, c < b.
.decl next(list: symbol, key: symbol, a: symbol, b: symbol)
next(l, k, a, b) :- member(l, k, a), member(l, k, b), a < b, !between(l, k, a, b).
.decl has_next(list: symbol, key: symbol, item: symbol)
has_next(l, k, a) :- next(l, k, a, _).
.decl joining(list: symbol, key: symbol, last: symbol, text: symbol)
joining(l, k, a, a) :- member(l, k, a), !not_first(l, k, a).
joining(l, k, b, cat(t, " ", b)) :- joining(l, k, a, t), next(l, k, a, b).
.decl joined(list: symbol, key: symbol, text: symbol)
joined(l, k, t) :- joining(l, k, a, t), !has_next(l, k, a).

member("rule-models", r, m) :- rule_model(r, m).
member("rule-facts", r, f) :- rule_fact(r, f).
member("rule-tags", r, cat(file, ":", to_string(line))) :- rule_tag(r, file, line, _, _).
member("race-models", r, m) :- race_model(r, m).
member("race-delays", r, cat(e, ".", s)) :- race_delay(r, e, s).
member("race-signals", r, cat(e, ".", s)) :- race_signal(r, e, s).
member("race-facts", r, f) :- race_fact(r, f).
member("race-model", r, cat(e, ".", s)) :- race_delay(r, e, s) ; race_signal(r, e, s).
member("fact-tags", f, cat(file, ":", to_string(line))) :- fact_tag(f, file, line).
member("need-facts", n, f) :- fact_need(f, n), fact_open(f, _).

// A list's text, "" for none.
.decl list(list: symbol, key: symbol, text: symbol)
list(l, k, t) :- joined(l, k, t).
list("rule-models", r, "") :- rule(r, _, _, _, _), !has_members("rule-models", r).
list("rule-facts", r, "") :- rule(r, _, _, _, _), !has_members("rule-facts", r).
list("rule-tags", r, "") :- rule(r, _, _, _, _), !has_members("rule-tags", r).
list("race-models", r, "") :- race(r, _, _, _), !has_members("race-models", r).
list("race-delays", r, "") :- race(r, _, _, _), !has_members("race-delays", r).
list("race-signals", r, "") :- race(r, _, _, _), !has_members("race-signals", r).
list("race-facts", r, "") :- race(r, _, _, _), !has_members("race-facts", r).
list("race-model", r, "") :- race(r, _, _, _), !has_members("race-model", r).
list("fact-tags", f, "") :- fact_id(f), !has_members("fact-tags", f).

// The order the queries list the rules in, by status.
.decl status_rank(status: symbol, rank: number)
status_rank("applied", 0).
status_rank("proposed", 1).
status_rank("missing", 2).

// The queries, for ../knowledge.sh NAME. A first column named rank orders
// the rows (then the others do, from the left), and is not printed.
.decl query(name: symbol, title: symbol)
query("assumptions",
      "What each proof against the netlist rests on, directly or through the proofs of what it assumes, and the evidence.").
query("borrowed-rules",
      "The rules for the chips looked at that no fact about them shows: they follow another chip's evidence.").
query("delays",
      "The delays of rtl/ other than the flip-flops', with their race.").
query("departures",
      "Where ceres departs from the netlist, and what each rests on.").
query("followed-rules",
      "The rules that hold on a chip looked at only as it follows another (the CGB the DMG), and what they explain.").
query("needs",
      "What settling the open questions takes, by how many open facts it serves.").
query("open-assumptions",
      "The open assumptions, and the proofs that rest on each.").
query("pulses",
      "The short pulses at controls, by signal, with their race if classified (those under 10 ns first).").
query("race-links",
      "The links of races.toml from a race to a fact, and whether a signal connects them: connected, or unchecked where one of the two sits nowhere in rtl/.").
query("race-fact-neighbours",
      "The width races and the facts within an edge of each other that races.toml does not link: links to look at.").
query("races",
      "The races of the model, with what they cover and the facts on each.").
query("rules",
      "The rules beyond the die's connectivity, with their kind, status and facts.").
query("untested-rules",
      "The rules for the chips looked at whose facts no hardware test shows: they rest on documents, emulators or a guess.").
query("width-facts",
      "The facts on a width race, with its delays, signals and the fact's tags.").
.output query(IO=file, filename="queries.tsv")

.decl assumptions(harness: symbol, assumption: symbol, evidence: symbol, via: symbol)
assumptions(h, a, e, "directly") :- assumes(h, a), assumption(a, _, e, _).
assumptions(h, a, e, "through others") :- rests(h, a), !assumes(h, a), assumption(a, _, e, _).

.decl borrowed_rules(rank: number, status: symbol, id: symbol, models: symbol, facts: symbol)
.decl rule_shown_here(rule: symbol)
rule_shown_here(r) :- rule_fact(r, f), fact_here(f).
borrowed_rules(n, status, r, models, facts) :-
    rule_here(r), !rule_shown_here(r), rule(r, _, _, status, _), status_rank(status, n),
    list("rule-models", r, models), list("rule-facts", r, facts).

// The race that covers a delay or the pulses at a signal, "" for none.
.decl delay_race(file: symbol, line: number, entity: symbol, signal: symbol, delays: symbol,
                 race: symbol)
delay_race(file, line, e, s, d, r) :- delay(file, line, e, s, d), race_delay(r, e, s), race_here(r).
delay_race(file, line, e, s, d, r) :-
    delay(file, line, e, s, "tco"), d = "tco", race_delay(r, "", "tco"), race_here(r).
delay_race(file, line, e, s, d, "") :- delay(file, line, e, s, d), !delay_covered(e, s, d).

.decl delays(entity: symbol, signal: symbol, delays: symbol, site: symbol, race: symbol)
delays(e, s, d, cat(file, ":", to_string(line)), r) :- delay_race(file, line, e, s, d, r), d != "tco".

.decl departures(id: symbol, hardware: symbol, tests: number, open_questions: number,
                 title: symbol)
departures(f, h, tests, open, title) :-
    fact(f, title, "differs", h, _, _, _),
    tests = count : { fact_test(f, _) }, open = count : { fact_open(f, _) }.

.decl followed_rules(model: symbol, rule: symbol, status: symbol, follows: symbol,
                    facts: symbol)
followed_rules(m, r, status, from, facts) :-
    rule_holds(r, m), tree_model(m), !rule_stated(r, m), rule(r, _, _, status, _),
    follows(top, from), covers(top, m), rule_holds(r, from), list("rule-facts", r, facts).

.decl needs(rank: number, need: symbol, facts: number, which: symbol)
needs(-n, need, n, which) :-
    member("need-facts", need, _), n = count : { member("need-facts", need, _) },
    list("need-facts", need, which).

.decl open_assumptions(assumption: symbol, harness: symbol, title: symbol)
open_assumptions(a, h, title) :- rests(h, a), assumption(a, title, "open", _).

.decl pulse_race(entity: symbol, signal: symbol, race: symbol)
pulse_race(e, s, r) :- pulse_signal(e, s, _), race_signal(r, e, s), race_here(r).
pulse_race(e, s, r) :- pulse_signal(e, s, _), base(s, b), race_signal(r, e, b), race_here(r).
pulse_race(e, s, "") :- pulse_signal(e, s, _), !pulse_covered(e, s).
.decl pulses(rank: number, entity: symbol, signal: symbol, kind: symbol, roms: number,
             pulses: number, shortest_ns: float, a_rom: symbol, race: symbol)
pulses(rank, e, s, kind, roms, pulses, shortest, rom, r) :-
    pulse_shortest(e, s, kind, shortest), (shortest < 10, rank = 0 ; shortest >= 10, rank = 1),
    roms = count : { pulse_rom(e, s, kind, _) },
    pulses = sum n : { runt_at_control(_, e, s, _, n, _, _, _, kind) },
    shortest_rom(e, s, kind, rom), !later_rom(e, s, kind, rom), pulse_race(e, s, r).

.decl race_links(race: symbol, fact: symbol, signals: symbol)
race_links(r, f, cat("connected, ", to_string(d), " edges apart")) :-
    race_fact(r, f), nearest(r, f, d).
race_links(r, f, "connected, more than 3 edges apart") :-
    race_fact(r, f), connected(r, f), !nearest(r, f, _).
race_links(r, f, "not connected") :- race_fact(r, f), race_placed(r), fact_placed(f), !connected(r, f).
race_links(r, f, "unchecked: the race is nowhere in rtl/") :- race_fact(r, f), !race_placed(r).
race_links(r, f, "unchecked: the fact is nowhere in rtl/") :-
    race_fact(r, f), race_placed(r), !fact_placed(f).

.decl race_fact_neighbours(race: symbol, fact: symbol, edges: number)
race_fact_neighbours(r, f, d) :- nearest(r, f, d), d <= 1, race(r, _, "width", _), !race_fact(r, f).

.decl races(rank: number, race: symbol, id: symbol, models: symbol, delays: symbol,
            signals: symbol, facts: symbol)
races(n, kind, r, models, delays, signals, facts) :-
    race(r, _, kind, _), (kind = "width", n = 0 ; kind != "width", n = 1),
    list("race-models", r, models), list("race-delays", r, delays),
    list("race-signals", r, signals), list("race-facts", r, facts).

.decl rules(rank: number, status: symbol, kind: symbol, id: symbol, models: symbol,
            facts: symbol, tags: symbol)
rules(n, status, kind, r, models, facts, tags) :-
    rule(r, _, kind, status, _), status_rank(status, n),
    list("rule-models", r, models), list("rule-facts", r, facts), list("rule-tags", r, tags).

.decl untested_rules(rank: number, status: symbol, id: symbol, models: symbol, facts: symbol)
.decl rule_tested(rule: symbol)
rule_tested(r) :- rule_fact(r, f), fact(f, _, _, h, _, _, _), h != "none".
untested_rules(n, status, r, models, facts) :-
    rule_here(r), !rule_tested(r), rule(r, _, _, status, _), status_rank(status, n),
    list("rule-models", r, models), list("rule-facts", r, facts).

.decl width_facts(fact: symbol, race: symbol, model: symbol, tags: symbol)
.decl fact_raced(fact: symbol)
fact_raced(f) :- race_fact(_, f).
width_facts(f, r, model, tags) :-
    fact(f, _, _, _, _, "width", _), race_fact(r, f), race(r, _, _, _),
    list("race-model", r, model), list("fact-tags", f, tags).
width_facts(f, "", "", tags) :-
    fact(f, _, _, _, _, "width", _), !fact_raced(f), list("fact-tags", f, tags).

.output assumptions(IO=file, filename="assumptions.tsv", headers=true)
.output borrowed_rules(IO=file, filename="borrowed-rules.tsv", headers=true)
.output delays(IO=file, filename="delays.tsv", headers=true)
.output departures(IO=file, filename="departures.tsv", headers=true)
.output followed_rules(IO=file, filename="followed-rules.tsv", headers=true)
.output needs(IO=file, filename="needs.tsv", headers=true)
.output open_assumptions(IO=file, filename="open-assumptions.tsv", headers=true)
.output pulses(IO=file, filename="pulses.tsv", headers=true)
.output race_links(IO=file, filename="race-links.tsv", headers=true)
.output race_fact_neighbours(IO=file, filename="race-fact-neighbours.tsv", headers=true)
.output races(IO=file, filename="races.tsv", headers=true)
.output rules(IO=file, filename="rules.tsv", headers=true)
.output untested_rules(IO=file, filename="untested-rules.tsv", headers=true)
.output width_facts(IO=file, filename="width-facts.tsv", headers=true)
